#!/bin/bash
# Minimal applicable pipeline: lock, pre-update snapshot, full upgrade, boot check.
set -euo pipefail
if (( EUID != 0 )); then exec sudo -- "$0" "$@"; fi
[[ $# == 0 || $* == -y ]] || { echo 'Usage: omarchy-update [-y]' >&2; exit 2; }
exec 9>/run/omarchy-server-update.lock
flock -n 9 || { echo 'Another server update is running.' >&2; exit 1; }
omarchy-snapshot create
args=(); [[ ${1:-} != -y ]] || args+=(--noconfirm)
# One full transaction updates the keyring packages as well. No desktop migrations.
pacman -Syu "${args[@]}"
limine-update
if [[ -d /sys/firmware/efi ]]; then
  [[ -s /boot/EFI/Linux/omarchy_linux-omarchy.efi ]] || {
    echo 'Boot verification failed: server UKI is missing' >&2; exit 1;
  }
else
  # BIOS uses the same kernel/initramfs entries as upstream, without a UKI.
  kernel_dir="/boot/$(cat /etc/machine-id)/linux-omarchy"
  [[ -s $kernel_dir/vmlinuz && -s $kernel_dir/initramfs ]] || {
    echo "Boot verification failed: $kernel_dir" >&2; exit 1;
  }
fi
limine-snapper-sync
printf 'Update complete; reboot when convenient.\n'
