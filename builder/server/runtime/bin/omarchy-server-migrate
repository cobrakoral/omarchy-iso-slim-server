#!/usr/bin/python3
"""Run only explicitly reviewed server/shared migrations, with durable receipts."""

import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
from datetime import datetime, timezone

BASE = Path("/usr/share/omarchy/server-migrations")
STATE = Path("/var/lib/omarchy-server/migrations")
EDITION = Path("/etc/omarchy-edition")
LOCK = Path("/run/omarchy-server-migrate.lock")


def atomic_json(path, value):
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix=".pending-", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as target:
            json.dump(value, target, indent=2)
            target.write("\n")
            target.flush()
            os.fsync(target.fileno())
        os.replace(name, path)
        parent = os.open(path.parent, os.O_DIRECTORY)
        try:
            os.fsync(parent)
        finally:
            os.close(parent)
    finally:
        Path(name).unlink(missing_ok=True)


def plan(base=BASE, state=STATE):
    entries = json.loads((base / "manifest.json").read_text())
    if not isinstance(entries, list):
        raise ValueError("Migration manifest must be a list")
    seen, planned = set(), []
    previous = ""
    for entry in entries:
        name, scope = entry["id"], entry["scope"]
        if (
            not re.fullmatch(r"[0-9]{4}-[a-z0-9-]+", name)
            or name in seen
            or name <= previous
        ):
            raise ValueError("Migration IDs must be unique, ordered and stable")
        if scope not in ("server", "shared", "desktop"):
            raise ValueError("Unknown migration scope: " + scope)
        seen.add(name)
        previous = name
        relative = Path(entry["file"])
        path = (base / relative).resolve()
        if (
            relative.is_absolute()
            or not path.is_relative_to(base.resolve())
            or not path.is_file()
        ):
            raise ValueError("Migration must be a packaged file beneath its directory")
        digest = hashlib.sha256(path.read_bytes()).hexdigest()
        if digest != entry["sha256"] or entry.get("idempotent") is not True:
            raise ValueError("Migration digest/idempotence review missing: " + name)
        receipt = state / (name + ".json")
        done = None
        if receipt.exists():
            done = json.loads(receipt.read_text())
            if done["sha256"] != digest or done["scope"] != scope:
                raise ValueError("Applied migration was changed: " + name)
        planned.append((entry, path, receipt, done is not None))
    return planned


def migrate(base=BASE, state=STATE, pending=False):
    # Validate the entire manifest/ledger before running any migration.
    steps = plan(base, state)
    for entry, path, receipt, done in steps:
        name = entry["id"]
        if entry["scope"] == "desktop":
            print("Skip desktop migration:", name, flush=True)
            continue
        if done:
            continue
        if pending:
            print(name)
            continue
        journal = state / "pending.json"
        atomic_json(journal, {**entry, "phase": "running"})
        print("Running", entry["scope"], "migration:", name, flush=True)
        environment = os.environ.copy()
        environment.pop("OMARCHY_PATH", None)
        environment.pop("OMARCHY_MIGRATION_STATE", None)
        environment["OMARCHY_EDITION"] = "server"
        subprocess.run(
            ["bash", "-euo", "pipefail", str(path)], check=True, env=environment
        )
        atomic_json(
            receipt, {**entry, "applied_at": datetime.now(timezone.utc).isoformat()}
        )
        journal.unlink()
        fd = os.open(state, os.O_DIRECTORY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--pending", action="store_true")
    args = parser.parse_args()
    if (
        os.geteuid() != 0
        or not EDITION.is_file()
        or EDITION.read_text().strip() != "server"
    ):
        raise ValueError("Server migrations require root on the server edition")
    os.umask(0o077)
    with LOCK.open("w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise ValueError("Another server migration is running")
        migrate(pending=args.pending)


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as error:
        print("error: Server migration failed:", error, file=sys.stderr)
        sys.exit(1)
