#!/bin/bash
# Bash/Gum text front end to the shared Archinstall orchestrator.
set -euo pipefail
umask 077
trap 'unset password password_hash passphrase PASSWORD_REPLY PASSWORD_WEAK_REASON; rm -f /run/server-answers.json' EXIT
export GUM_INPUT_SHOW_HELP=false GUM_CHOOSE_SHOW_HELP=false
printf 'Omarchy Slim Server — unofficial edition\nAll packages install offline. The selected disk will be erased.\n'
locale=$(python /usr/share/omarchy-iso/server_config.py --list-locales | gum filter --header 'System language / locale (default en_US.UTF-8)' --value en_US.UTF-8)
keyboard=$(localectl list-keymaps | gum filter --header 'Console keyboard layout' --value us)
loadkeys "$keyboard"
hostname=$(gum input --header Hostname --value omarchy-server)
username=$(gum input --header 'Administrator username' --value admin)
# A weak password is a conscious user choice, not an installer-fatal error.
# Never print the password in diagnostics or pass it as a command argument.
weak_password_reason() {
  local candidate=$1 lowered=${1,,}
  PASSWORD_WEAK_REASON=''
  if ((${#candidate} < 8)); then
    PASSWORD_WEAK_REASON='It has fewer than 8 characters.'
  elif [[ $lowered =~ ^(password[0-9]*|senha[0-9]*|admin[0-9]*|qwerty[0-9]*|123456[0-9]*|letmein|welcome)$ ]]; then
    PASSWORD_WEAK_REASON='It follows a very common password pattern.'
  elif [[ $candidate =~ ^[0-9]+$ && ${#candidate} -lt 14 ]]; then
    PASSWORD_WEAK_REASON='It uses only a short sequence of digits.'
  fi
  [[ -n $PASSWORD_WEAK_REASON ]]
}

prompt_secret() {
  local description=$1 confirmation=$2 candidate repeated hint=''
  while :; do
    if ! candidate=$(gum input --password --header "$description (8+ characters recommended)${hint:+ — $hint}"); then
      printf 'Password entry cancelled.\n' >&2
      return 1
    fi
    if [[ -z $candidate ]]; then
      hint='Password cannot be empty'
      printf 'Password cannot be empty. Please try again.\n' >&2
      continue
    fi
    if ! repeated=$(gum input --password --header "$confirmation"); then
      printf 'Password confirmation cancelled.\n' >&2
      unset candidate
      return 1
    fi
    if [[ $candidate != "$repeated" ]]; then
      hint='Confirmation differs, please try again'
      printf 'Passwords do not match. Please try again.\n' >&2
      unset candidate repeated
      continue
    fi
    unset repeated
    if weak_password_reason "$candidate"; then
      # No weak password is accepted by default. A declined warning returns
      # to password entry, without throwing away the rest of the wizard.
      if ! gum confirm --default=false --affirmative 'Use Anyway' \
          --negative 'Choose Another' \
          "Weak password. $PASSWORD_WEAK_REASON Are you sure you want to use it?"; then
        hint='Weak password declined, choose another'
        unset candidate
        continue
      fi
    fi
    PASSWORD_REPLY=$candidate
    unset candidate
    return 0
  done
}

PASSWORD_REPLY=''
prompt_secret 'Administrator password (console and sudo)' 'Confirm password'
password_hash=$(printf '%s' "$PASSWORD_REPLY" | openssl passwd -6 -stdin)
unset PASSWORD_REPLY
timezone=$(timedatectl list-timezones | gum filter --header Timezone --value UTC)
# One existing networking choice, with optional per-interface customization.
# Unattended installs bypass this Gum menu and use automatic dual-stack.
source /usr/share/omarchy-iso/server-network-menu.sh
network_menu /usr/share/omarchy-iso/server_config.py
keys=$(gum input --header 'Optional path to SSH public-key file (on mounted local media)')
if [[ -n $keys ]]; then
  ssh-keygen -l -f "$keys" >/dev/null
  cp -- "$keys" /root/authorized_keys
else
  rm -f /root/authorized_keys
fi
encrypt=false; passphrase=''
if gum confirm --default=false 'Encrypt the disk with LUKS? (default No)'; then
  encrypt=true
  prompt_secret 'LUKS passphrase' 'Confirm LUKS passphrase'
  passphrase=$PASSWORD_REPLY
  unset PASSWORD_REPLY
fi
cloud_init=false
if gum confirm --default=false 'Install cloud-init? (default No)'; then cloud_init=true; fi
selection=$(python /usr/share/omarchy-iso/server_config.py --list-disks | gum choose --header 'Installation disk — ERASES THE WHOLE DISK')
read -r disk disk_seq _ <<<"$selection"
[[ $disk_seq =~ ^[1-9][0-9]*$ ]] || { echo 'Installation disk identity is missing.' >&2; exit 1; }
gum confirm --default=false "Erase $disk and install $hostname?" || exit 1
jq -n --arg disk "$disk" --argjson disk_seq "$disk_seq" \
  --arg hostname "$hostname" --arg username "$username" \
  --rawfile password_hash <(printf '%s' "$password_hash") \
  --arg timezone "$timezone" --arg keyboard "$keyboard" --arg locale "$locale" \
  --argjson network_interfaces "$NETWORK_INTERFACES_JSON" \
  --rawfile encryption_password <(printf '%s' "$passphrase") \
  --argjson encrypt "$encrypt" --argjson cloud_init "$cloud_init" \
  '$ARGS.named' >/run/server-answers.json
unset passphrase password_hash
python /usr/share/omarchy-iso/server_config.py /run/server-answers.json
